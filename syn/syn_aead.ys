# Yosys synthesis script for AEAD-only Ascon core

# read design 
read_verilog -sv ../rtl/ascon_top.v
read_verilog -sv ../rtl/ascon_core.v
read_verilog -sv ../rtl/ascon_permutation.v

# generic synthesis
synth -top ascon_top

# mapping to Nangate 45nm
dfflibmap -liberty ../syn/nangate45.lib
abc -liberty ../syn/nangate45.lib
clean

# write synthesized design
write_verilog syn_aead_nangate.v

# print statistics
stat -liberty ../syn/nangate45.lib